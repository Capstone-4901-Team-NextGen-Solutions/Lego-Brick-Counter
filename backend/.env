# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
FLASK_ENV=development
DEBUG=True
SECRET_KEY=generate-a-random-secret-key-here
JWT_SECRET_KEY=generate-another-random-secret-key
PORT=5000

SENDGRID_API_KEY=SG.xxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
FRONTEND_URL=https://your-deployed-app.com   (for link generation)
# ============================================================================
# AZURE CUSTOM VISION CONFIGURATION
# ============================================================================
# Prediction Endpoint (NO trailing slash)
AZURE_CV_PREDICTION_ENDPOINT=https://legovisiontraining-prediction.cognitiveservices.azure.com

# Prediction Key (REGENERATE THIS - the old one is compromised!)
AZURE_CV_PREDICTION_KEY=FJf1qGztLEhaHsNOWrautJ4Ow1DE2pu8reRmZHh1ztJ53j6KtvgmJQQJ99CBAC8vTInXJ3w3AAAIACOGoLPx

# Project ID
AZURE_CV_PROJECT_ID=13f493c3-3c6f-446a-9dd3-ae82dae2c651

# Published Model Name
AZURE_CV_PUBLISHED_NAME=Iteration2

# Detection Confidence Threshold
CONFIDENCE_THRESHOLD=0.12

# ============================================================================
# PINECONE CONFIGURATION (Optional)
# ============================================================================
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=lego-bricks

# ============================================================================
# REDIS CONFIGURATION (for caching)
# ============================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=simple

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# FILE UPLOAD SETTINGS
# ============================================================================
MAX_UPLOAD_SIZE_MB=16
UPLOAD_FOLDER=uploads
